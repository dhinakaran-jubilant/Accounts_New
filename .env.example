# ==============================================================================
# LoanDesk - Production Environment Variables Template
# Copy this file to .env and configure values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Flask Application & Security Settings
# ------------------------------------------------------------------------------
# A secure, random secret key for session signing and CSRF tokens in production
# Generate one using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-secure-random-32-byte-secret-key

# Flask environment & debugging: set to False in production!
FLASK_DEBUG=False
FLASK_ENV=production

# Server listening host & port (0.0.0.0 binds to all network interfaces)
HOST=0.0.0.0
PORT=1110
BACKEND_PORT=1110

# Local Server Network IP (automatically detected by run.py, e.g. 192.168.0.7)
SERVER_NETWORK_IP=192.168.0.7

# Allowed CORS origins (comma-separated domains, or * for all)
# Example: https://app.yourdomain.com,https://admin.yourdomain.com,http://192.168.0.21:1111
CORS_ORIGINS=*

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
# Option A: Full connection URL (Standard for Heroku, AWS RDS, Render, Docker)
# DATABASE_URL=postgresql+psycopg2://username:password@localhost:5432/accounts_new

# Option B: Individual connection parameters
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=accounts_new
PG_USER=postgres
PG_PASSWORD=1234

# ------------------------------------------------------------------------------
# Application & File Storage Configuration
# ------------------------------------------------------------------------------
# APP_CONFIG_PATH=backend/app_config.json

# Path to Tesseract-OCR binary if OCR for scanned PDFs is required
# Windows default: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux default: /usr/bin/tesseract
# TESSERACT_PATH=/usr/bin/tesseract

# ------------------------------------------------------------------------------
# Frontend Settings (Vite / React)
# ------------------------------------------------------------------------------
# API URL used by the frontend build.
# In production with a reverse proxy (e.g. Nginx routing /api to Flask), leave blank or set to /api
# If backend is hosted on a separate domain: https://api.yourdomain.com/api
VITE_API_URL=/api

# Local development ports & proxy
VITE_PORT=1111
VITE_PROXY_TARGET=http://127.0.0.1:1110
